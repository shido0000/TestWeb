# ============================================
# TestHub Backend Configuration
# ============================================

# Environment
NODE_ENV=development

# PostgreSQL Database
POSTGRES_USER=testhub
POSTGRES_PASSWORD=testhub_secret
POSTGRES_DB=testhub
DATABASE_URL=postgresql://testhub:testhub_secret@localhost:5432/testhub

# Redis
REDIS_URL=redis://localhost:6379

# MinIO (S3-compatible storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=testhub-storage

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# API Configuration
API_PORT=3000
API_HOST=0.0.0.0
API_CORS_ORIGIN=http://localhost:5173

# Worker Configuration
WORKER_CONCURRENCY=3
WORKER_MAX_RETRIES=3
WORKER_TIMEOUT=300000

# Playwright Configuration
PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000

# Scanner Configuration
CRAWLER_MAX_DEPTH=5
CRAWLER_RATE_LIMIT=10
CRAWLER_RESPECT_ROBOTS=true

# Lighthouse Configuration
LIGHTHOUSE_PERFORMANCE_BUDGET=90
LIGHTHOUSE_ACCESSIBILITY_BUDGET=90

# OWASP ZAP (Phase 2)
ZAP_API_URL=http://zap:8080
ZAP_API_KEY=your-zap-api-key

# Nuclei (Phase 2)
NUCLEI_TEMPLATES_PATH=/nuclei-templates
NUCLEI_SEVERITY=critical,high,medium

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Email (for notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@testhub.io
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@testhub.io

# Slack Integration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Jira Integration
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_USER_EMAIL=your-email@domain.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=SEC
