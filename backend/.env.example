# ============================================
# TestHub Backend Configuration
# ============================================

# Environment
NODE_ENV=development

# PostgreSQL Database
POSTGRES_USER=testhub
POSTGRES_PASSWORD=testhub_secret
POSTGRES_DB=testhub
DATABASE_URL=postgresql://testhub:testhub_secret@localhost:5432/testhub

# Redis
REDIS_URL=redis://localhost:6379

# MinIO (S3-compatible storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=testhub-storage

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# API Configuration
API_PORT=3000
API_HOST=0.0.0.0
API_CORS_ORIGIN=http://localhost:5173

# Worker Configuration
WORKER_CONCURRENCY=3
WORKER_MAX_RETRIES=3
WORKER_TIMEOUT=300000

# Playwright Configuration
PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000

# Scanner Configuration
CRAWLER_MAX_DEPTH=5
CRAWLER_RATE_LIMIT=10
CRAWLER_RESPECT_ROBOTS=true

# Lighthouse Configuration
LIGHTHOUSE_PERFORMANCE_BUDGET=90
LIGHTHOUSE_ACCESSIBILITY_BUDGET=90

# OWASP ZAP (Phase 2)
ZAP_API_URL=http://zap:8080
ZAP_API_KEY=your-zap-api-key

# Nuclei (Phase 2)
NUCLEI_TEMPLATES_PATH=/nuclei-templates
NUCLEI_SEVERITY=critical,high,medium

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Email (for notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@testhub.io
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@testhub.io

# ============================================
# Phase 2 - Security Tools
# ============================================

# OWASP ZAP
ZAP_API_URL=http://zap:8080
ZAP_API_KEY=testhub-zap-key

# Nuclei
NUCLEI_TEMPLATES_PATH=/nuclei-templates
NUCLEI_SEVERITY=critical,high,medium

# testssl.sh
TESTSSL_PATH=/opt/testssl.sh

# ============================================
# Phase 2 - Integrations
# ============================================

# Slack Integration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Jira Integration
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_USER_EMAIL=your-email@domain.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=SEC

# Microsoft Teams
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/YOUR/WEBHOOK/URL

# PagerDuty
PAGERDUTY_SERVICE_KEY=your-pagerduty-service-key

# Custom Webhook
WEBHOOK_URL=https://your-domain.com/webhooks/testhub
WEBHOOK_SECRET=your-webhook-secret

# ============================================
# Phase 2 - CI/CD Integration
# ============================================

# GitHub
GITHUB_TOKEN=your-github-token

# GitLab
GITLAB_TOKEN=your-gitlab-token

# Jenkins
JENKINS_URL=http://jenkins:8080
JENKINS_USER=admin
JENKINS_TOKEN=your-jenkins-token

# ============================================
# Phase 3 - AI & ML
# ============================================

# OpenAI (for AI insights)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4

# AI Configuration
AI_CONFIDENCE_THRESHOLD=70
AI_PATTERN_MIN_OCCURRENCES=3

# ============================================
# Phase 3 - Billing (Stripe)
# ============================================

# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
STRIPE_PRICE_PRO_MONTHLY=price_pro_monthly_id
STRIPE_PRICE_PRO_YEARLY=price_pro_yearly_id
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_enterprise_monthly_id
STRIPE_PRICE_ENTERPRISE_YEARLY=price_enterprise_yearly_id

# ============================================
# Phase 3 - Multi-Tenant
# ============================================

# Tenant Configuration
DEFAULT_PLAN=free
MAX_TENANTS_PER_USER=5
TENANT_SLUG_MIN_LENGTH=3
TENANT_SLUG_MAX_LENGTH=30
