{
  "name": "testhub",
  "version": "1.0.0",
  "private": true,
  "description": "TestHub - Automated Web Testing Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "docker-compose up",
    "dev:api": "npm run dev -w apps/api",
    "dev:worker": "npm run dev -w apps/worker",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/api && npm run build -w apps/worker && npm run build -w apps/web",
    "build:api": "npm run build -w apps/api",
    "build:worker": "npm run build -w apps/worker",
    "build:web": "npm run build -w apps/web",
    "db:migrate": "npm run db:migrate -w packages/database",
    "db:seed": "npm run db:seed -w packages/database",
    "db:studio": "npm run db:studio -w packages/database",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "npm run test -w apps/api && npm run test -w apps/worker",
    "test:api": "npm run test -w apps/api",
    "test:worker": "npm run test -w apps/worker",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/dist packages/*/dist"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "prettier": "^3.1.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
